  updated_at DateTime @default(now()) @db.Timestamp(0)

  @@ignore
}

model users {
  id                      Int                       @id @default(autoincrement()) @db.UnsignedInt
  provider                String?                   @db.VarChar(200)
  provider_id             String?                   @db.Text
  terms                   String?                   @db.VarChar(100)
  updator_id              Int?
  creator_id              Int?
  role_id                 Int                       @db.UnsignedInt
  username                String?                   @db.VarChar(100)
  email                   String?                   @db.VarChar(100)
  password                String?                   @db.VarChar(100)
  hide                    Boolean
  verified                Boolean?
  verify_key              String?                   @db.VarChar(100)
  email_verified_at       DateTime?                 @db.Timestamp(0)
  remember_token          String?                   @db.VarChar(100)
  temp_email              String?                   @db.VarChar(100)
  created_at              DateTime?                 @db.DateTime(0)
  updated_at              DateTime?                 @db.DateTime(0)
  password_changed_at     DateTime?                 @default(now()) @db.Timestamp(0)
  last_activity_at        DateTime?                 @db.Timestamp(0)
  client_id               Int?
  article_comment_replies article_comment_replies[]
  applicants  applicants[] 
}

model wallets {
  id         Int      @id @default(autoincrement())
  balance    Float
  client_id  Int?
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
}

