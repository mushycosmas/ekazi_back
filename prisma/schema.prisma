model applicant_counter_offer_benefits {
  id                         Int                      @id @default(autoincrement())
  applicant_counter_offer_id Int
  benefit_id                 Int                      @db.UnsignedInt
  created_at                 DateTime?                @default(now()) @db.Timestamp(0)
  updated_at                 DateTime?                @default(now()) @db.Timestamp(0)
  benefits                   benefits                 @relation(fields: [benefit_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_benefit")
  applicant_counter_offers   applicant_counter_offers @relation(fields: [applicant_counter_offer_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_counter_offer")

  @@index([benefit_id], map: "fk_benefit")
  @@index([applicant_counter_offer_id], map: "fk_counter_offer")
}

model applicant_counter_offers {
  id                               Int                                @id @default(autoincrement())
  applicant_job_offer_id           Int
  working_hour                     String?                            @db.VarChar(50)
  working_day                      String?                            @db.VarChar(50)
  description                      String?                            @db.Text
  probabition                      String?                            @db.VarChar(50)
  salary                           Decimal?                           @db.Decimal(15, 2)
  updator_id                       Int?
  creator_id                       Int?
  duration                         String?                            @db.VarChar(100)
  starting_date                    DateTime?                          @db.Date
  created_at                       DateTime?                          @default(now()) @db.Timestamp(0)
  updated_at                       DateTime?                          @default(now()) @db.Timestamp(0)
  applicant_counter_offer_benefits applicant_counter_offer_benefits[]
  applicant_job_offers             applicant_job_offers               @relation(fields: [applicant_job_offer_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_applicant_offer")

  @@index([applicant_job_offer_id], map: "fk_applicant_offer")
}

model applicant_course {
  id           Int @id @default(autoincrement()) @db.UnsignedInt
  level_id     Int @db.UnsignedInt
  applicant_id Int @db.UnsignedInt
  course_id    Int
  created_at   Int
  updated_at   Int
}

model applicant_cultures {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  applicant_id Int       @db.UnsignedInt
  culture_id   Int       @db.UnsignedInt
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
   // Relations
  applicant    applicants @relation(fields: [applicant_id], references: [id])
  culture      cultures   @relation(fields: [culture_id], references: [id])

  @@unique([applicant_id, culture_id]) // ensures one culture per applicant only once
}

