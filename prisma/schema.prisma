  token                         String                             @db.Text
  sent_by                       BigInt                             @db.UnsignedBigInt
  created_at                    DateTime?                          @db.Timestamp(0)
  updated_at                    DateTime?                          @db.Timestamp(0)
  applicant_reference_responses applicant_reference_responses[]
}

model applicant_reference_responses {
  id                         BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  reference_check_id         BigInt                     @db.UnsignedBigInt
  question_id                BigInt                     @db.UnsignedBigInt
  response                   String?                    @db.Text
  created_at                 DateTime?                  @db.Timestamp(0)
  updated_at                 DateTime?                  @db.Timestamp(0)
  reference_questionnaires   reference_questionnaires   @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_questionnaire")
  applicant_reference_checks applicant_reference_checks @relation(fields: [reference_check_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_reference_check")

  @@index([question_id], map: "fk_questionnaire")
  @@index([reference_check_id], map: "fk_reference_check")
}

